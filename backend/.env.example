# Copia este archivo como .env y completa los valores. El .env no se sube a git.

# Conexión a PostgreSQL (driver psycopg 3)
DATABASE_URL=postgresql+psycopg://usuario:contraseña@localhost:5432/golazo

# Clave para firmar los tokens JWT: una cadena larga y aleatoria, distinta en
# cada entorno. Puedes generarla con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Orígenes del frontend que pueden llamar a la API, separados por comas
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
